{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_unused_import,
    warn_export_vars,
    verbose,
    report,
    {i, "src"}
]}.
{base_dir, "../../../build/rebar3"}.

{deps, []}.

{dialyzer, [
    {warnings, [
        % Dialyzer's core warning classes are enabled by default. These
        % additional classes make contracts and ignored results stricter.
        % `underspecs` is intentionally omitted: public FFI contracts must
        % describe all valid callers, not mirror today's narrower inference.
        unmatched_returns,
        error_handling,
        extra_return,
        missing_return,
        overlapping_contract,
        opaque_union,
        unknown
    ]},
    {get_warnings, true},
    {plt_apps, top_level_deps},
    {base_plt_apps, [erts, kernel, stdlib]},
    {base_plt_location, local},
    {plt_location, local},
    incremental
]}.

{profiles, [
    {nix, [
        {plugins, [
            {rebar3_nix, ".*",
                {git, "https://github.com/erlang-nix/rebar3_nix.git", {tag, "v0.1.1"}}}
        ]}
    ]}
]}.
